<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reverse.approval.internal.persistence.ReferenceLineMapper">

    <insert id="insertReferenceLine"
            parameterType="com.reverse.approval.internal.persistence.param.ReferenceLineParam">
        INSERT INTO reference_line (
            approval_id,
            referencer_id,
            referencer_name,
            reference_rank
        )
        VALUES (
            #{approvalId},
            #{referencerId},
            #{referencerName},
            #{referenceRank}
        )
    </insert>

</mapper>
