<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reverse.approval.internal.persistence.VacationDetailMapper">

    <insert id="insertVacationDetail"
            parameterType="com.reverse.approval.internal.persistence.param.VacationDetailParam">
        INSERT INTO vacation_detail (
            approval_id,
            vacation_type,
            start_dt,
            end_dt,
            reason
        )
        VALUES (
            #{approvalId},
            #{vacationType},
            #{startDate},
            #{endDate},
            #{reason}
        )
    </insert>

</mapper>
