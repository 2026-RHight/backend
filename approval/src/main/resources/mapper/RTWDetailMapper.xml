<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reverse.approval.internal.persistence.RTWDetailMapper">

    <insert id="insertRtwDetail"
            parameterType="com.reverse.approval.internal.persistence.param.RTWDetailParam">
        INSERT INTO rtw_detail (
            approval_id,
            rtw_date,
            reason
        )
        VALUES (
            #{approvalId},
            #{RTWDate},
            #{reason}
        )
    </insert>

</mapper>
